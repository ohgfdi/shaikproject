/**
 * Regenerate lib/server/jsonld-hashes.ts from the template catalogue.
 *
 * The JSON-LD emitted by `app/templates/[id]` is derived from the static
 * catalogue, so its SHA-256 hash is stable and can be pinned into the
 * Content-Security-Policy `script-src`. That page is statically generated, so it
 * cannot receive a per-request CSP nonce — a hash is the strictly stronger
 * alternative to `'unsafe-inline'`.
 *
 * The hashed string comes from the SAME helper the page renders
 * (`templateJsonLd`), so the page and the policy cannot drift.
 *
 * `__tests__/unit/security-headers.test.ts` recomputes this and fails if the
 * committed file is stale, so run this only when that test tells you to.
 *
 * Run: npm run generate:jsonld-hashes
 */
import { createHash } from "node:crypto";
import { writeFileSync } from "node:fs";
import path from "node:path";

import { ANALYSIS_TEMPLATES } from "../lib/engine/template-catalog.ts";
import { templateJsonLd } from "../lib/engine/template-jsonld.ts";

const root = path.resolve(import.meta.dirname, "..");

// CSP hash-source entries are the bare token `sha256-<base64>`; the surrounding
// quotes are CSP SYNTAX, added by whoever embeds the value. Storing them here
// would double-quote in the header and silently break the policy.
const hashes = ANALYSIS_TEMPLATES.map((template) => {
  const digest = createHash("sha256").update(templateJsonLd(template), "utf8").digest("base64");
  return `sha256-${digest}`;
});

const body = `/**
 * CSP hashes for the statically-generated JSON-LD blocks.
 *
 * \`app/templates/[id]\` is statically generated (generateStaticParams) and
 * emits one inline \`<script type="application/ld+json">\` per template. A
 * statically generated page cannot receive a per-request CSP nonce, so those
 * scripts are authorised by SHA-256 **hash** instead — which is strictly
 * stronger than \`'unsafe-inline'\`, because the hash only matches that exact
 * byte sequence.
 *
 * The hashed string comes from the shared \`templateJsonLd\` helper the page
 * renders, so the policy cannot drift from the markup.
 *
 * GENERATED by scripts/generate-jsonld-hashes.mts — do not edit by hand.
 * \`__tests__/unit/security-headers.test.ts\` recomputes these and fails if they
 * are stale.
 */
export const JSONLD_SCRIPT_HASHES: string[] = [
${hashes.map((h) => `  "${h}",`).join("\n")}
];
`;

writeFileSync(path.join(root, "lib/server/jsonld-hashes.ts"), body, "utf8");
// eslint-disable-next-line no-console
console.log(`wrote ${hashes.length} JSON-LD hash(es) → lib/server/jsonld-hashes.ts`);
