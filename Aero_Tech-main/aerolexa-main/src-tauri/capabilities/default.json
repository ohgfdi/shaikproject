{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for Ledgerly - full Tauri v2 capability set",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-set-focus",
    "core:window:allow-set-title",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-resizable",
    "core:window:allow-set-opacity",
    "core:window:allow-set-always-on-top",
    "core:window:allow-center",
    "core:window:allow-outer-position",
    "core:window:allow-inner-position",
    "core:window:allow-outer-size",
    "core:window:allow-inner-size",
    "core:window:allow-is-maximized",
    "core:window:allow-is-minimized",
    "core:window:allow-is-fullscreen",
    "core:window:allow-is-visible",
    "core:window:allow-is-focused",
    "core:window:allow-is-closable",
    "core:window:allow-is-maximizable",
    "core:window:allow-is-minimizable",
    "core:window:allow-is-resizable",
    "core:window:allow-is-always-on-top",
    "core:window:allow-is-decorated",
    "core:window:allow-is-transparent",
    "core:window:allow-is-active",
    "core:webview:allow-create-webview-window",
    "core:webview:allow-close-webview-window",
    "core:webview:allow-set-webview-window-size",
    "core:webview:allow-set-webview-window-position",
    "core:webview:allow-set-webview-window-fullscreen",
    "core:event:default",
    "core:menu:default",
    "core:menu:allow-new-menu",
    "core:menu:allow-new-submenu",
    "core:menu:allow-set-menu",
    "core:menu:allow-popup",
    "core:tray:default",
    "core:tray:allow-new-tray",
    "core:tray:allow-set-icon",
    "core:tray:allow-set-menu",
    "core:tray:allow-set-tooltip",
    "core:tray:allow-set-visible",
    "core:tray:allow-is-visible",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "fs:default",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-read-dir",
    "fs:allow-create-dir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-copy-file",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "shell:default",
    "shell:allow-open",
    "shell:allow-execute",
    "shell:allow-spawn",
    "log:default",
    "log:allow-log",
    "updater:default"
  ]
}
