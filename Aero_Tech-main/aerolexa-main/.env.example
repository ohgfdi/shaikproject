[TEMPLATE]
# Ledgerly prototype — local development environment
# Copy this file to `.env` and adjust. `npm run dev` creates a `.env` automatically
# (with a freshly generated AUTH_SECRET) when one is missing.

# --- Application -------------------------------------------------------------
# Public URL of this instance. Used for links in emails and absolute redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database ----------------------------------------------------------------
# Default: local SQLite (zero-setup one-click dev). The same schema runs on
# PostgreSQL — change the provider in prisma/schema.prisma to "postgresql" and
# point DATABASE_URL at your instance (see docker-compose.yml for a local PG).
# SQLite path is resolved relative to prisma/schema.prisma.
DATABASE_URL="file:../data/aerolexa.db"

# --- PostgreSQL connection pool (Phase 4.2) ----------------------------------
# Only used when DATABASE_URL is postgres:// or postgresql://.
# Sizing rule: DATABASE_POOL_MAX × number_of_replicas must stay under the
# database's max_connections, minus headroom for migrations and admin.
# DATABASE_POOL_MAX=10
# DATABASE_POOL_CONNECT_TIMEOUT_MS=5000
# DATABASE_POOL_IDLE_TIMEOUT_MS=30000
# A runaway analytics query must not hold a pooled connection indefinitely.
# DATABASE_STATEMENT_TIMEOUT_MS=30000
# Verify TLS certificates (off by default so the Prisma 7 upgrade was not also
# an outage). Set true in production, with NODE_EXTRA_CA_CERTS for a private CA.
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# --- Supabase (optional) ------------------------------------------------------
# Next.js only inlines variables prefixed NEXT_PUBLIC_ into the browser bundle,
# so these two use that prefix. They are read through lib/env-public.ts and
# consumed by lib/supabase/client.ts (browser) and lib/supabase/server.ts
# (server). Leave them blank to keep the current Prisma/SQLite-or-Postgres
# behaviour — Supabase is additive, not a replacement.
# Project URL: Supabase dashboard → Project Settings → API → Project URL.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable/anon key: safe to ship to the browser, still subject to RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER-ONLY. Bypasses Row Level Security — never expose it to the client and
# never commit it. Only needed if you call getSupabaseAdminClient().
SUPABASE_SERVICE_ROLE_KEY=
# --- Supabase Postgres (Model A: Prisma-only, RLS stays off) -------------------
# The schema is already `provider = "postgresql"` and prisma/migrations/ holds
# the 31 PostgreSQL migrations, so no `switch:postgres` is needed — only the two
# URLs below. Credentials come from Supabase dashboard → Project Settings →
# Database (and are never committed: `.env` is gitignored).
#
# DATABASE_URL = runtime. Pooled/transaction mode (Supavisor, port 6543).
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# DIRECT_URL   = migrations only. Direct/session connection (port 5432).
#   postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
#
# prisma.config.ts prefers DIRECT_URL, so `prisma migrate deploy`/`migrate dev`
# never run DDL through the transaction pooler while the app keeps the 6543 URL.
# If db.<ref>.supabase.co is unreachable from your network (it is IPv6-only on
# many projects), use the pooler's SESSION port instead — same host/user as the
# runtime URL, port 5432:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Do NOT set RLS_ENABLED until the tenant-context refactor is complete and the
# tenancy audit is clean — enabling it with an unwired query layer hides rows.

# --- Auth & sessions ----------------------------------------------------------
# HS256 secret used to sign session cookies. Generate with: openssl rand -hex 32
AUTH_SECRET="change-me-generate-a-random-64-hex-secret"
# Lifetime of a signed session cookie, in days.
SESSION_TTL_DAYS=7
# Override session-cookie "Secure" flag: "true" always Secure, "false" never.
# Unset = Secure when NODE_ENV=production. Set "false" for plain-HTTP
# self-hosting (LAN / TLS-terminating proxy) and for the API test harness.
AUTH_COOKIE_SECURE=
# If "true", new users must click the emailed verification link before sign-in.
# In development no mail server is configured, so keep this "false" (default).
# Verification emails are always "sent" to the server console when MAIL_TRANSPORT=console.
# In production (NODE_ENV=production, i.e. `next start` / Docker) BOTH this and
# MAIL_TRANSPORT=smtp are REQUIRED unless you opt out below.
AUTH_REQUIRE_EMAIL_VERIFY=false

# --- Production safety gate ---------------------------------------------------
# `next start`, the Docker images and the hosted runbook all run with
# NODE_ENV=production. In that mode the server REFUSES to boot with a dev
# transport, because console mail prints verification/reset links (and console
# OTP prints sign-in codes) to the server log — letting anyone reading the log
# take over accounts. A clean launch therefore sets MAIL_TRANSPORT=smtp with
# real SMTP_* credentials and AUTH_REQUIRE_EMAIL_VERIFY=true.
# Set this to "true" ONLY for a production-like-but-private box (staging, an
# internal demo, the zero-config `docker compose up` prototype) to accept the
# exposure knowingly.
ALLOW_INSECURE_PROD_TRANSPORTS=false

# --- Email ---------------------------------------------------------------
# console = print emails to server output (default, dev). smtp = real transport
# via nodemailer (production: verification, reset, scheduled reports, digest).
# MAIL_TRANSPORT=smtp REQUIRES SMTP_HOST — boot fails fast otherwise.
MAIL_TRANSPORT=console
# SMTP credentials (only used when MAIL_TRANSPORT=smtp) — never commit real values.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# false = STARTTLS on 587 (default); true = implicit TLS on 465.
SMTP_SECURE=false
MAIL_FROM="Ledgerly <no-reply@example.com>"

# --- Testing --------------------------------------------------------------
# Point the Postgres-gated integration suites (connectors-postgres,
# connector-scheduler) at a real server. Unset = those suites skip cleanly.
# One command spins up a disposable Postgres 16 and runs them for real:
#   npm run test:postgres
TEST_POSTGRES_URL=
# Same gate for the mySQL connector suite (npm run test:mysql spins up a
# disposable mySQL 8). Unset = that suite skips cleanly.
TEST_MYSQL_URL=
# Same gate for the MongoDB connector suite (npm run test:mongodb spins up a
# disposable MongoDB 7). Unset = that suite skips cleanly.
TEST_MONGODB_URL=

# --- Data handling -----------------------------------------------------------
# Directory where uploaded raw files and normalized row-streams are stored
# (relative to project root). Never point this at a public web directory.
DATA_DIR=data
# Hard cap on a JSON request body, in bytes. JSON requests carry config and
# parameters, not uploads, so this is small on purpose. Larger bodies are
# refused with HTTP 413 rather than buffered into memory.
MAX_JSON_BODY_BYTES=5242880
# Storage driver: "local" (single instance, default) or "s3" (multi-instance —
# files are written through to any S3-compatible store and read via a local
# cache; works with AWS S3, Cloudflare R2, MinIO, Backblaze B2).
LEDGERLY_STORAGE=local
# S3 settings (required when LEDGERLY_STORAGE=s3)
S3_BUCKET=
S3_REGION=auto
# Custom endpoint for S3-compatible stores, e.g. https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Path-style addressing is required by R2/MinIO; set false only for AWS virtual-host style.
S3_FORCE_PATH_STYLE=true
# Log level for structured JSON logs: debug | info | warn | error
LOG_LEVEL=info
# Maximum number of rows a single heavy analysis reads from disk. Larger files
# are analysed on a clearly-labelled sample of the first N rows.
DATASET_ANALYSIS_LIMIT=50000
# Maximum upload size in bytes (default 100 MB).
MAX_UPLOAD_BYTES=104857600

# --- AI / demo mode ----------------------------------------------------------
# "demo" = deterministic, in-repo prototype logic (clearly labelled in the UI).
# Future "live" providers plug in here. Never put provider API keys in this repo.
AI_MODE=demo

# --- AI generation (Anthropic Claude) ----------------------------------------
# Every copilot/agent/notebook generation call goes through lib/ai/provider.ts.
# SERVER-SIDE ONLY: never expose this key to a client bundle or a log. With no
# key, AI features fail honestly (the deterministic engines still answer) and
# GET /api/llm/status reports exactly what is configured and reachable.
ANTHROPIC_API_KEY=
# Model IDs are configuration, not code. Defaults are the current main/fast
# tiers; swap here without a redeploy of feature code.
AI_MODEL_MAIN=claude-sonnet-5-5
AI_MODEL_FAST=claude-haiku-5-5
# Per-request timeout (ms), retries after the first attempt, and the base for
# exponential backoff (ms). Retries apply to 429s, overloads, 5xx and network
# timeouts only.
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
AI_RETRY_BASE_DELAY_MS=500
# Optional USD price per million tokens, used only to report cost. Leave a
# value blank when the contracted price is unknown — costUsd is then null
# rather than a fabricated estimate. Anthropic bills cache reads and writes
# separately, so they have their own rates.
AI_COST_MAIN_INPUT_PER_MTOK=
AI_COST_MAIN_OUTPUT_PER_MTOK=
AI_COST_MAIN_CACHE_READ_PER_MTOK=
AI_COST_MAIN_CACHE_WRITE_PER_MTOK=
AI_COST_FAST_INPUT_PER_MTOK=
AI_COST_FAST_OUTPUT_PER_MTOK=
AI_COST_FAST_CACHE_READ_PER_MTOK=
AI_COST_FAST_CACHE_WRITE_PER_MTOK=

# --- Grounded assistant (READ tier only) -------------------------------------
# Global kill switch. false disables POST /api/assistant for every workspace.
ASSISTANT_ENABLED=true
# Per-organization switch default. Existing and new organizations start OFF
# unless an OWNER/ADMIN enables the assistant in settings.
ASSISTANT_ORGANIZATION_DEFAULT_ENABLED=false
# Hard per-run limits. The agent stops honestly when any limit is reached.
ASSISTANT_MAX_TOOL_CALLS=8
ASSISTANT_MAX_OUTPUT_TOKENS=8000
ASSISTANT_MAX_WALL_MS=60000
# Maximum estimated USD cost per run. Only enforced when the AI_COST_* prices
# above are configured; unknown pricing yields costUsd=null, never a guess.
ASSISTANT_MAX_COST_USD=0.5
ASSISTANT_MAX_QUESTION_CHARS=2000
# Per-user and per-organization request budget (requests per minute).
ASSISTANT_USER_RATE_LIMIT_PER_MINUTE=6
ASSISTANT_ORG_RATE_LIMIT_PER_MINUTE=30
# Append-only run/tool-call audit retention. Purged by the retention job.
ASSISTANT_LOG_RETENTION_DAYS=90

# --- Embedding credentials (legacy; not used for chat) -----------------------
# Chat generation no longer reads these. They remain for the optional
# EMBEDDING_PROVIDER=openai|ollama retrieval path only.
LLM_API_KEY=
LLM_BASE_URL=
OLLAMA_URL=http://localhost:11434

# --- Web search (copilot "use Google") ---------------------------------------
# Live web lookup for the Copilot chat. When both keys below are set the
# copilot searches Google through the Custom Search JSON API. When they are
# empty it falls back to a free, key-less DuckDuckGo lookup so the feature
# still works without signing up anywhere.
#   - API key: https://developers.google.com/custom-search/v1/overview
#   - Search engine id (cx): https://programmablesearchengine.google.com/
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ENGINE_ID=
SEARCH_RESULT_LIMIT=5

# --- Extended modules — ENABLED by default (Phase 3.1) -----------------------
# The analyst toolkit ships unfrozen out of the box: SQL Lab, notebook, what-if,
# training, advisor, connectors, scheduled reports, prompts and LLM features.
# Set LEDGERLY_PROFILE=core to return to the minimal core flow, or force a
# single module on with its own flag below (per-module flags win over profile).

# Master switch: "all" re-enables every module (SSO + collaboration included).
# An explicit module list keeps precedence over the profile below.
LEDGERLY_ENABLED_MODULES=

# Deployment profile — who this instance is for, in ONE switch:
#   pro  (default) = the full analyst toolkit: SQL Lab, notebook, what-if,
#                    connectors, scheduled reports, training, advisor, prompts,
#                    LLM. SSO/collaboration stay frozen (org/IT decisions).
#   core           = minimal core flow only; every extended module frozen.
#   all            = pro + SSO + team collaboration.
# Per-module flags still force a module ON for surgical control.
LEDGERLY_PROFILE=

# --- Deprecated aliases (still honoured, will be removed) -------------------
# The brand rename (Aerolexa → Ledgerly) moved these three switches to a
# LEDGERLY_* prefix. Existing deployments keep working untouched: the new name
# wins when both are set, the old name is used as a fallback, and a one-line
# deprecation warning is logged at boot. Rename them at your convenience.
#   AEROLEXA_ENABLED_MODULES  ->  LEDGERLY_ENABLED_MODULES
#   AEROLEXA_PROFILE          ->  LEDGERLY_PROFILE
#   AEROLEXA_STORAGE          ->  LEDGERLY_STORAGE

# Interactive notebook (deterministic DSL kernel). PYODIDE_ENABLED additionally
# gates the real Python kernel; NEXT_PUBLIC_PYODIDE_URL must point at the
# Pyodide assets for it to load in the browser.
# NOTEBOOK_ENABLED=true          # optional; already on under the default pro profile
PYODIDE_ENABLED=false
NEXT_PUBLIC_PYODIDE_URL=

# Real SERVER-SIDE Python (WS1): Pyodide (CPython 3.14 wasm) runs in a Node
# worker thread with numpy, pandas, scipy, scikit-learn, statsmodels and
# matplotlib. Cells have NO filesystem or network access. Opt-in: the first
# boot loads the wasm runtime (~2-10 s) and heavy wheels download once from
# the Pyodide CDN, then cache in node_modules. Cells run with a 20 s timeout
# (runaway loops are terminated). When false, code cells run on the browser
# kernel / deterministic DSL as before.
PYODIDE_SERVER_ENABLED=false

# SQL Lab (DuckDB engine; explicit ENGINE_UNAVAILABLE failure, opt-in labelled
# parser fallback via SQL_PROTOTYPE_FALLBACK).
# SQL_LAB_ENABLED=true           # optional; already on under the default pro profile
DUCKDB_ENABLED=true
SQL_PROTOTYPE_FALLBACK=false
DATASET_QUERY_LIMIT=5000

# Prototype model trainer (linear / logistic / k-means over uploaded rows).
# TRAINING_ENABLED=true          # optional; already on under the default pro profile

# What-if simulator (prototype linear-impact projection).
# WHATIF_ENABLED=true            # optional; already on under the default pro profile

# External data connectors (PostgreSQL/Snowflake/BigQuery/Sheets/REST). Empty
# connection strings below = "not configured" UI state even when unfrozen.
# CONNECTORS_ENABLED=true        # optional; already on under the default pro profile
CONNECTOR_POSTGRES_URL=
CONNECTOR_SNOWFLAKE_URL=
CONNECTOR_BIGQUERY_SERVICE_ACCOUNT=
CONNECTOR_GOOGLE_CLIENT_ID=

# Scheduled reports: the poller (instrumentation.ts) starts with the server
# whenever this module is enabled (on under the default pro profile) and stops
# when it is frozen. Set LEDGERLY_PROFILE=core to disable it.
# SCHEDULER_ENABLED=true         # optional; already on under the default pro profile

# Notification digest (ROADMAP 7.3): when true, a background loop emails each
# user their unread notifications as ONE periodic bundle (scheduled-report
# failures, connector errors, analysis alerts). The in-app bell stays the
# system of record; delivery uses the configured mail transport (console in
# dev).
DIGEST_ENABLED=false
PARTNER_DIGEST_ENABLED=false  # weekly owner/admin digest: deadlines, WIP, receivables, collected

# Team collaboration — two distinct things share this flag:
#   1. Project members with OWNER/EDITOR/VIEWER roles (always stored).
#   2. WS4 real-time co-editing: notebooks sync through Yjs CRDT rooms
#      (character-level merges, presence/cursor colors) over SSE + POST on
#      /api/notebooks/[id]/collab. No websocket server needed.
COLLABORATION_ENABLED=false

# Server-side rendering of dashboards, reports and widgets to image/PDF
# (the /api/render/* and /api/*/[id]/render routes).
RENDERING_ENABLED=false

# LLM-backed features: copilot chat, natural-language → code, and chart
# recommendations (/api/llm/*). Also needs a provider key below.
# LLM_ENABLED=true               # optional; already on under the default pro profile

# Enterprise SSO. When false the UI shows "Connect SSO" states and the login
# screen offers email + password only.
SSO_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
SAML_METADATA_URL=
# Google SSO (NextAuth). When SSO_ENABLED=true AND both values below are set,
# the login screen shows "Continue with Google". Create credentials at
# https://console.cloud.google.com/apis/credentials and register the redirect
# URI <NEXT_PUBLIC_APP_URL>/api/auth/callback/google. New accounts are
# provisioned on first sign-in and linked to existing ones by verified email.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# NextAuth encrypts its session cookie with this secret. Leave blank to reuse
# AUTH_SECRET (recommended for the single-instance prototype).
NEXTAUTH_SECRET=
# Public origin used for OAuth callbacks. NextAuth derives it from the request
# in development; set it explicitly behind a proxy or in production.
NEXTAUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Government-portal filing (docs/gst-portal-execution.md)
# EVERY filing leaves the app through ONE transport, chosen here. The default
# is "reference": a deterministic local IRN hash that transmits NOTHING.
#   reference  — no network; every receipt is labelled "nothing was transmitted"
#   simulation — deterministic in-process portal; the full lifecycle runs offline
#   live       — real HTTPS to GSTN IRP / income-tax e-filing. Requires the full
#                credential set for FILING_CHANNEL below; a live deployment
#                missing one REFUSES TO BOOT (fail-closed), so a half-configured
#                install can never reach filing time.
# Credentials are env-only and never stored in the database. The operator
# procedure for switching a deployment to live is docs/filing-go-live-runbook.md.
#   irp-irn   — register taxpayer API access on the IRP or go through a GSP. The
#               IRP issues the client id/secret AND the portal username/password,
#               and mails its RSA public key (the auth envelope is encrypted to
#               it). The auth token it returns is valid for 360 minutes.
#   efiling-* — onboard as a Type-2 ERI on the e-filing portal
#               (https://www.incometax.gov.in/iec/foportal/api-specifications);
#               the registration pack issues the client id/secret and the
#               token/submit endpoints.
FILING_GATEWAY=reference
# Enforce per-client shadow/live filing. When true, a client with no FilingRollout
# row is in shadow and submission is refused until a manager promotes it.
FILING_ROLLOUT_ENFORCED=false
FILING_CHANNEL=irp-irn

# --- GSTN IRP (FILING_CHANNEL=irp-irn) ---
# The live handshake is hybrid RSA + AES: an auth call (RSA/PKCS1) mints an
# AuthToken + Sek, then each IRN submit is AES-256/ECB-encrypted with the Sek.
FILING_GSTIN=
# IRP partition for the taxpayer: einvoice1..einvoice6.gst.gov.in.
# Sandbox: https://einv-apisandbox.nic.in
FILING_IRP_BASE_URL=https://einvoice1.gst.gov.in
FILING_IRP_CLIENT_ID=
FILING_IRP_CLIENT_SECRET=
# IRP portal login for the GSTIN (the auth-handshake grant).
FILING_IRP_PORTAL_USER=
FILING_IRP_PORTAL_PASSWORD=
# IRP RSA public key (PEM) — required for live. Paste on ONE line with \n
# escapes; it is normalised at use.
FILING_IRP_PUBLIC_KEY=
# Version-prefixed IRP paths. Confirm the current prefix for your onboarding.
FILING_IRP_AUTH_PATH=/eivital/v1.04/auth
FILING_IRP_ENDPOINT_PATH=/eicore/v1.03/Invoice
# Optional: a fixed 32-byte base64 AppKey (else minted per auth round-trip),
# and GSP-level signature headers (only for GSP-mediated access).
FILING_IRP_APP_KEY=
FILING_IRP_GSP_AUTH_TOKEN=
FILING_IRP_GSP_AUTH_SIGNATURE=

# --- Income-tax e-filing (FILING_CHANNEL=efiling-return | efiling-audit) ---
FILING_EFILING_TOKEN_URL=
FILING_EFILING_SUBMIT_URL=
FILING_EFILING_CLIENT_ID=
FILING_EFILING_CLIENT_SECRET=
# Optional session (password) grant; blank uses client_credentials.
FILING_EFILING_USERNAME=
FILING_EFILING_PASSWORD=
# ERI response field paths: comma-separated dotted JSON paths, first present
# wins. Leave blank for the documented defaults, or set them to match your ERI
# registration pack so a mismatched portal needs no code change, e.g.
#   FILING_EFILING_ACK_NUMBER_FIELD="response.ack.num,ackNo"
FILING_EFILING_TOKEN_FIELD=
FILING_EFILING_ACK_NUMBER_FIELD=
FILING_EFILING_ACK_DATE_FIELD=
FILING_EFILING_STATUS_FIELD=
FILING_EFILING_ERROR_CODE_FIELD=
FILING_EFILING_ERROR_MESSAGE_FIELD=
# Key the ITR JSON is wrapped under in the submit body; blank posts it raw.
FILING_EFILING_SUBMIT_BODY_KEY=json

# --- Remote DSC signing service (required for live efiling-audit) ---
# The app never holds a DSC private key. It posts the SHA-256 digest to this
# endpoint and receives a PKCS#1 v1.5 RSA/SHA-256 signature. Set all four for
# FILING_CHANNEL=efiling-audit; boot fails closed if any is missing.
FILING_SIGNING_URL=
FILING_SIGNING_TOKEN=
FILING_SIGNING_USER=
FILING_SIGNING_CERT_SERIAL=
# Public certificate (PEM) used to VERIFY detached receipt/filing signatures
# offline. Optional: without it, verification reports "not verified" rather
# than claiming success.
FILING_SIGNING_CERT_PEM=
FILING_SIGNING_TIMEOUT_MS=20000

# Upper bound for a single portal round-trip (ms); transport retries are bounded separately.
FILING_TIMEOUT_MS=20000

# --- Live-filing credential monitor (scheduler tick) ---
# When FILING_GATEWAY=live and the scheduler is on, the poll tick re-runs the
# credential preflight periodically and raises an in-app alert to firm admins
# when the handshake stops working (and again when it recovers) — so a revoked
# or rotated credential surfaces BEFORE a due date, not on one. No-op unless
# FILING_GATEWAY=live.
FILING_CREDENTIAL_MONITOR_ENABLED=true
# Minutes between repeat alerts while the handshake keeps failing.
FILING_CREDENTIAL_ALERT_COOLDOWN_MINUTES=360
# Minutes between preflight probes (the scheduler ticks every 60s; probing the
# portal every minute would be gratuitous and rate-limit bait).
FILING_CREDENTIAL_CHECK_INTERVAL_MINUTES=60
# Twilio SMS Credentials (for compliance reminders, OTP, engagement notifications)
# Get these from: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567

# --- Xero (connector) ---------------------------------------------------------
# Create an app at developer.xero.com, add the redirect URI below, then connect
# from the connectors screen. Each connected tenant's refresh token is stored
# encrypted in its Connector row; Xero rotates it on every exchange, so the app
# always persists the newest value.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Defaults to <NEXT_PUBLIC_APP_URL>/api/integrations/xero/callback when unset.
# Must match the redirect URI registered on the Xero app exactly.
XERO_REDIRECT_URI=

# --- Operations: metrics + separate worker --------------------------------
# Prometheus scrape token. /api/metrics returns 404 unless the request carries
# "Authorization: Bearer $METRICS_TOKEN". Leave unset to keep deployment
# posture off the network entirely.
# METRICS_TOKEN=generate-a-long-random-token
# Queue alert thresholds, in minutes (defaults: warn 15, critical 60).
# QUEUE_PENDING_WARN_MINUTES=15
# QUEUE_PENDING_CRITICAL_MINUTES=60
# Run the durable job worker as its own process (`npm run worker`) and leave
# JOB_WORKER_ENABLED=false on web replicas, so bulk work cannot starve requests.
