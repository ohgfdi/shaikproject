{
  "name": "Ledgerly",
  "type": "module",
  "version": "0.6.1",
  "private": true,
  "description": "Ledgerly — from raw data to boardroom decisions. Data-driven analytics workspace for CA firms, consultants & SMBs.",
  "license": "MIT",
  "engines": {
    "node": ">=18.18.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "postcss": "^8.5.28",
    "nodemailer": "^10.0.10",
    "@next/eslint-plugin-next": {
      "glob": "10.5.0"
    },
    "js-yaml": "^4.3.2"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "prisma generate && node scripts/check-memory.mjs && next build && node scripts/check-bundle-budgets.mjs",
    "start": "node scripts/start.mjs",
    "worker": "tsx scripts/worker.mts",
    "copy:duckdb": "node scripts/copy-duckdb-assets.mjs",
    "postinstall": "prisma generate && npm run copy:duckdb",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx prisma/seed.ts",
    "switch:postgres": "node scripts/switch-provider.mjs postgresql",
    "switch:sqlite": "node scripts/switch-provider.mjs sqlite",
    "typecheck": "tsc --noEmit",
    "tenancy:audit": "tsx scripts/tenancy-audit.mts",
    "generate:jsonld-hashes": "node --experimental-strip-types scripts/generate-jsonld-hashes.mts",
    "verify:csp": "node --experimental-strip-types scripts/verify-csp-live.mts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "analyze": "ANALYZE=true next build",
    "test": "jest --runInBand --testPathPatterns='__tests__/(unit|components)'",
    "test:watch": "jest --watch",
    "test:components": "jest --runInBand --testPathPatterns='__tests__/components'",
    "test:api": "jest --runInBand --testPathPatterns='__tests__/api'",
    "test:postgres": "node scripts/test-postgres.mjs",
    "filing:conformance": "tsx scripts/filing-conformance.mts",
    "filing:canary": "tsx scripts/filing-canary.mts",
    "filing:certify": "tsx scripts/filing-certify.mts",
    "preflight:prod": "tsx scripts/preflight-prod.mts",
    "drill:backup": "node scripts/backup-drill.mjs",
    "demo": "node scripts/sales-demo.mjs",
    "test:mysql": "node scripts/test-mysql.mjs",
    "test:mongodb": "node scripts/test-mongodb.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:device-lab": "DEVICE_LAB=1 playwright test --project=device-lab",
    "stills": "node scripts/capture-stills.mjs",
    "lighthouse:compare": "node scripts/lighthouse-compare.mjs",
    "bench:duckdb": "jest --runInBand --testPathPatterns='__tests__/unit/duckdb-benchmark'",
    "verify:worker": "node scripts/verify-training-worker.mjs",
    "audit": "npm audit --omit=dev",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@aws-sdk/client-s3": "^3.1132.0",
    "@duckdb/duckdb-wasm": "^1.33.1-dev57.0",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@react-three/postprocessing": "3.0.4",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-virtual": "^3.14.10",
    "@tauri-apps/api": "^2.12.2",
    "@tauri-apps/cli": "^2.12.1",
    "@types/csv-parse": "^1.1.12",
    "@types/leaflet": "^1.9.22",
    "@types/xlsx": "^0.0.35",
    "@types/xml2js": "^0.4.14",
    "apache-arrow": "^17.0.0",
    "apexcharts": "^4.5.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.2",
    "echarts": "^6.1.0",
    "esbuild": "^0.28.2",
    "framer-motion": "^11.15.0",
    "idb": "^8.0.4",
    "jose": "^5.9.6",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.469.0",
    "mongodb": "^7.6.0",
    "mysql2": "^3.24.4",
    "next": "^15.5.25",
    "next-auth": "^4.24.15",
    "nodemailer": "^10.0.10",
    "papaparse": "^5.4.1",
    "pg": "^8.23.0",
    "playwright": "^1.63.0",
    "postprocessing": "6.38.0",
    "pyodide": "^314.0.6",
    "react": "19.2.8",
    "react-apexcharts": "^1.9.0",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "read-excel-file": "^5.7.1",
    "remark-gfm": "^4.0.1",
    "swr": "^2.2.5",
    "tailwind-merge": "^2.6.0",
    "three": "0.165.0",
    "twilio": "^6.3.0",
    "vite": "^8.3.4",
    "workbox-window": "^7.4.1",
    "workerpool": "^6.5.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "xml-crypto": "^6.3.2",
    "xml2js": "^0.6.2",
    "y-indexeddb": "^9.0.12",
    "yjs": "^13.6.32",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@jest/globals": "^30.5.2",
    "@napi-rs/canvas": "^1.0.11",
    "@next/bundle-analyzer": "^15.5.25",
    "@playwright/test": "^1.50.1",
    "@swc/jest": "^0.2.37",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.17.10",
    "@types/nodemailer": "^7.0.12",
    "@types/papaparse": "^5.3.15",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.8",
    "@types/supertest": "^6.0.2",
    "@types/three": "0.165.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "axe-core": "^4.13.0",
    "dotenv": "^18.0.4",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "sharp": "^0.35.5",
    "supertest": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "allowScripts": {
    "@swc/core@1.16.2": true,
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "@parcel/watcher": false
  }
}
