/// TDS Entry — tax deducted at source with challan tracking
model TdsEntry {
  id           String   @id @default(cuid())
  bookId       String
  book         Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  // Challan details
  challanNumber String  // BSR code + challan serial
  bsrCode       String
  challanDate   String  // ISO yyyy-mm-dd
  challanAmount Int     // minor units

  // Deductor (the book entity)
  deductorTan   String
  deductorName  String
  deductorGstin String?

  // Deductee
  deducteePan   String
  deducteeName  String
  deducteeGstin String?
  deducteeType  String  // company | firm | individual | huf | other

  // Section & Amounts
  section       String  // 192 | 194A | 194C | 194H | 194I | 194J | 194Q | etc.
  natureOfPayment String
  grossAmount   Int     @default(0) // minor units
  tdsAmount     Int     @default(0)
  surcharge     Int     @default(0)
  cess          Int     @default(0)
  totalTax      Int     @default(0)

  // Period
  quarter       String  // Q1 | Q2 | Q3 | Q4
  fy            String  // "2025-26"

  // Status & Filing
  status        String  @default("deducted") // deducted | deposited | filed | corrected
  depositedAt   DateTime?
  filedAt       DateTime?
  form26Q_27Q   String? // which form this goes to

  // Voucher link
  voucherId     String?
  voucher       BookVoucher? @relation(fields: [voucherId], references: [id])

  // Correction
  originalEntryId String? // TdsEntry.id if this is a correction
  correctionReason String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   String

  @@index([bookId, fy, quarter])
  @@index([bookId, deducteePan])
  @@index([bookId, section])
  @@index([bookId, status])
}

/// Closing Entry — period-end closing journals
model ClosingEntry {
  id           String   @id @default(cuid())
  bookId       String
  book         Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  number       String   // e.g. "CLS-2025-001"
  date         String   // ISO yyyy-mm-dd (last day of period)
  narration    String
  period       String   // "2025-26" or "2025-03"

