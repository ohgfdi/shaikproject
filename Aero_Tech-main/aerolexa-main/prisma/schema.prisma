// ---------------------------------------------------------------------------
// Statute & notification rule registry (filing-grade rule provenance)
//
// The compute engines can take any rate table; what they could not show is
// WHERE a number came from, WHO published it, WHEN it took effect and WHAT it
// replaced. These four models are that layer:
//
//   StatuteSource        an authority feed/document the firm ingests from
//   StatuteNotification  one published item, deduped by content hash
//   StatutoryRule        a catalogue slot ("cess", "tds-section-rate", ...)
//   StatutoryRuleVersion one value of a slot with an effective window, a
//                        citation, the notification it came from and the
//                        version it supersedes
//
// Nothing is auto-published: an ingested notification produces DRAFT versions
// that a reviewer confirms (lib/server/statutes.ts). A published version is
// immutable — a change is a NEW version that supersedes the previous one, which
// is what makes the audit trail reproducible.
// ---------------------------------------------------------------------------

model StatuteSource {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// Stable key used by the parser and for dedupe (e.g. "cbdt-notifications").
  key       String
  name      String
  /// cbdt | cbic | mca | rbi | epfo | gst-council | state | other
  authority String
  /// Public feed/document URL consumed by the ingester (SSRF-guarded fetch).
  url       String
  /// json | rss | html
  format    String  @default("json")
  kind      String  @default("notification")
  active    Boolean @default(true)
  /// Advisory check cadence. Nothing depends on it being a valid cron.
  checkCron String?

  lastCheckedAt DateTime?
  lastStatus    String?
  lastError     String?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notifications StatuteNotification[]

  @@unique([workspaceId, key])
  @@index([workspaceId])
}

model StatuteNotification {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceId    String
  source      StatuteSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  /// The authority's own identifier, when the feed provides one.
  externalId    String?
  title         String
  url           String
  authority     String
  kind          String
  publishedAt   String?
  /// Dates PROPOSED from the text; a reviewer confirms before publishing.
  effectiveFrom String?
  effectiveTo   String?
  excerpt       String
  /// SHA-256 of the canonical content — dedupe + change detection.
  contentHash   String
  /// JSON array of catalogue slots the parser matched.
  impactedRuleKeys String
  /// JSON array of reviewer warnings (no date found, no slot matched, ...).
  warnings String @default("[]")
  /// new | reviewing | applied | ignored
  status   String @default("new")

  fetchedAt DateTime  @default(now())
  appliedAt DateTime?

  versions StatutoryRuleVersion[]

  @@unique([workspaceId, sourceId, contentHash])
  @@index([workspaceId, status])
  @@index([sourceId])
}

model StatutoryRule {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// Catalogue slot key (RULE_CATALOG in lib/engine/statutes.ts).
  key         String
  label       String
  unit        String
  authority   String
  description String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions StatutoryRuleVersion[]

  @@unique([workspaceId, key])
  @@index([workspaceId])
}

model StatutoryRuleVersion {
  id          String          @id @default(cuid())
  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ruleId      String
  rule        StatutoryRule   @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  version Int
  /// Assessment year ("2026-27") or null = any year.
  ay          String?
  /// JSON arrays; empty = "any" (that is what makes specificity ranking work).
  entityTypes String  @default("[]")
  states      String  @default("[]")
  /// central | state
  scope       String  @default("central")
  unit        String
  /// JSON array of { upTo, rate, label? } — integers only, no float drift.
  rows        String
  valueSummary String
  citation     String
  /// Inclusive start of the effective window (yyyy-mm-dd).
  effectiveFrom String
  /// Exclusive end of the effective window, or null = in force until superseded.
  effectiveTo   String?
  /// draft | published | superseded
  status String @default("draft")

  notificationId String?
  notification   StatuteNotification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  /// The version this one replaces (immutability chain).
  supersedesId String?
  supersedes   StatutoryRuleVersion?  @relation("RuleVersionChain", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy StatutoryRuleVersion[] @relation("RuleVersionChain")
  /// SHA-256 of the canonical content (tamper + duplicate detection).
  contentHash  String

  createdAt     DateTime  @default(now())
  publishedAt   DateTime?
  publishedById String?
  publishedBy   User?     @relation(fields: [publishedById], references: [id], onDelete: SetNull)
  notes         String?

  @@unique([workspaceId, ruleId, version])
  @@index([workspaceId, ruleId])
  @@index([ruleId, status])
}

// ---------------------------------------------------------------------------
// Export Compliance — LUT (Letter of Undertaking) & Shipping Bills
// ---------------------------------------------------------------------------

model LutApplication {
  id               String   @id @default(cuid())
  bookId           String
  gstin            String
  fy               String
  applicationType  String // LUT | BOND
  amount           Int      @default(0) // minor units
  dateOfIssue      String
  validUpto        String
  status           String   @default("DRAFT") // DRAFT|SUBMITTED|APPROVED|REJECTED|EXPIRED|CANCELLED
  reasonForRejection String?
  submittedById    String?
  approvedById     String?
  approvedAt       String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([bookId, gstin, fy, applicationType])
  @@index([gstin, fy])
  @@index([bookId, status])
}

model ShippingBill {
  id                  String   @id @default(cuid())
  bookId              String
  invoiceId           String
  gstin               String
  fy                  String
  exportInvoiceNumber String
  shippingBillNumber  String
  dateOfExport        String
  portOfExport        String
  billOfLading        String?
  status              String   @default("PENDING") // PENDING|APPROVED|REJECTED|PROCESSED

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([bookId, shippingBillNumber])
  @@index([bookId, invoiceId])
  @@index([gstin, fy])
}

// ---------------------------------------------------------------------------
// Books assistant (Phase 2) — append-only run/call log
// ---------------------------------------------------------------------------
// Inputs are scrubbed identifiers only; tool outputs are stored as a short
// summary plus a SHA-256 hash, never as a second copy of client financial data.
// Rows are written once and updated only to record completion/usage; no delete
// API exists. The retention sweep removes runs older than the configured
// window (default 90 days).

model AssistantRun {
  id             String   @id @default(cuid())
  requestId      String   @unique
  idempotencyKey String?
  userId         String
  workspaceId    String
  organizationId String?
  bookId         String?
  question       String // scrubbed and truncated before insert
  status         String   @default("running") // running | completed | verification_failed | failed | aborted | limit
  answer         String?
  verification   String? // JSON: ok, failures, checked counts
  toolCallCount  Int      @default(0)
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  costUsd        Float?
  latencyMs      Int      @default(0)
  errorCode      String?
  promptVersion  String   @default("phase2-v1")
  createdAt      DateTime @default(now())
  completedAt    DateTime?

  toolCalls AssistantToolCall[]

  @@unique([userId, idempotencyKey])
  @@index([workspaceId, createdAt])
  @@index([organizationId, createdAt])
  @@index([createdAt])
}

model AssistantToolCall {
  id            String   @id @default(cuid())
  runId         String
  run           AssistantRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  seq           Int
  toolName      String
  resultId      String
  inputJson     String
  outputSummary String
  outputHash    String
  ok            Boolean
  errorCode     String?
  latencyMs     Int      @default(0)
  createdAt     DateTime @default(now())

  @@unique([runId, seq])
  @@index([runId])
  @@index([toolName, createdAt])
}

model AssistantOrganizationSetting {
  organizationId String   @id
  enabled        Boolean  @default(false)
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// A document the firm has asked a client for — the "chasing" side of document
/// collection. `reminderCount`/`lastRemindedAt` are the audit trail of follow-up,
/// and `dueDate` is what makes an overdue request visible instead of a memory.
model ClientDocumentRequest {
  id            String   @id @default(cuid())
  // Legacy workspace-scoped requests keep their workspace; engagement-scoped
  // requests (created from the client portal panel) are keyed by engagement and
  // cascade with it.
  workspaceId   String?
  workspace     Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  engagementId  String?
  engagement    Engagement? @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  bookId        String?
  book          Book?    @relation(fields: [bookId], references: [id], onDelete: SetNull)

  clientName    String
  clientEmail   String?
  title         String
  category      String   // engagement-letter | financial-statement | gst-record | kyc | …
  period        String?  // yyyy-mm or FY label
  dueDate       String   // ISO yyyy-mm-dd
  status        String   @default("requested") // requested | received | waived
  notes         String?

  requestedById String
  lastRemindedAt DateTime?
  reminderCount  Int      @default(0)
  receivedAt     DateTime?
  // Set when the client uploads through the portal in answer to this request.
  fulfilledByUploadId String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([workspaceId, status])
  @@index([workspaceId, dueDate])
  @@index([engagementId, status])
}

// ---------------------------------------------------------------------------
// Practice economics — billable time and client invoices.
//
// Time is logged against an engagement (and optionally a filing run), valued in
// paise at the rate that applied when it was recorded, and frozen into a
// PracticeInvoice when the firm bills it. This is deliberately separate from
// the subscription `Invoice` model (which bills the firm's own Ledgerly plan):
// a client invoice must never be confused with the SaaS receipt.
// ---------------------------------------------------------------------------

model PracticeTimeEntry {
  id             String     @id @default(cuid())
  organizationId String
  engagementId   String
  engagement     Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  /// Optional link to the filing run this time was spent on.
  taskId         String?
  userId         String
  workDate       String // yyyy-mm-dd
  minutes        Int
  ratePerHourMinor Int
  billable       Boolean    @default(true)
  narrative      String?
  /// Set when the entry is frozen into an invoice; null = unbilled WIP.
  invoiceId      String?
  invoice        PracticeInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([organizationId, workDate])
  @@index([engagementId, invoiceId])
  @@index([userId, workDate])
}

model PracticeInvoice {
  id             String     @id @default(cuid())
  organizationId String
  engagementId   String
  engagement     Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  number         String     @unique
  currency       String     @default("INR")
  subtotalMinor  Int
  taxMinor       Int
  totalMinor     Int
  /// issued | paid | void
  status         String     @default("issued")
  issuedOn       String // yyyy-mm-dd
  dueDate        String // yyyy-mm-dd
  notes          String?
  /// Settlement record. paidOn is the date the money was received; the
  /// reference is the UTR/Razorpay payment id, never a customer-supplied note.
  paidOn           String?
  paymentReference String?
  paymentMethod    String? // manual | razorpay | upi | bank-transfer
  razorpayOrderId   String? @unique
  razorpayPaymentId String?
  voidedOn          String?
  voidReason        String?
  createdById    String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  entries PracticeTimeEntry[]

  @@index([organizationId, status])
  @@index([engagementId, issuedOn])
}
