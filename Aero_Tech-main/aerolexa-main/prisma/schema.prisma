// ---------------------------------------------------------------------------
// Copilot chat threads (persisted conversation history)
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Phone/OTP auth (Band 3.1) — short-lived one-time codes for passwordless
// sign-in on the phone number attached to an account. Codes are stored HASHED
// (bcrypt), expire in 5 minutes, allow ≤5 verification attempts, and rows are
// deleted once consumed or expired — no OTP material outlives its purpose.
// ---------------------------------------------------------------------------

model PhoneOtp {
  id          String    @id @default(cuid())
  phone       String // normalized E.164 the code was sent to
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose     String    @default("LOGIN") // LOGIN | LINK_PHONE
  codeHash    String // bcrypt hash — the raw code is never stored
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  ipHash      String? // one-way hash of the request IP (consent-proof style)
  createdAt   DateTime  @default(now())

  @@index([phone, createdAt])
  @@index([userId])
}

model Chat {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  title     String  @default("New chat")
  webSearch Boolean @default(true)
  model     String? // "provider:model" the thread last answered with

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]

  @@index([workspaceId, userId, updatedAt])
}

model ChatMessage {
  id     String @id @default(cuid())
  chatId String
  chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)

  role    String // user | assistant
  content String
  sources String? // JSON ChatSource[] when the assistant cited live web results

  createdAt DateTime @default(now())

  @@index([chatId, createdAt])
}

// ---------------------------------------------------------------------------
// Monetization (Band 4.2): Plan → Subscription → Invoice.
//
// A Plan is the purchasable product (Free/Pro/Firm) with prices in paise
// (INR minor units — never floats). A Subscription binds a workspace to a
// plan with period bounds. Invoices record each charge with an idempotent
// provider reference. Two payment rails, honestly labelled:
//   - razorpay : checkout order created server-side; payment verified via
//                HMAC signature (webhook + client callback both checked)
//   - manual   : offline transfer (NEFT/UPI) — invoice flips to PAID only
//                when an operator records the payment reference
// No plan gates any engine — billing is honest bookkeeping, not a meter that
// silently degrades computed results.
// ---------------------------------------------------------------------------

model Plan {
  id          String  @id
  // "free" | "pro" | "firm"
  name        String
  description String?
  amountPaise Int     @default(0) // 0 = free plan
  currency    String  @default("INR")
  interval    String  @default("month") // month | year
  features    String  @default("[]") // JSON string[] shown on the pricing panel
  isActive    Boolean @default(true)

  subscriptions Subscription[]
}

model Subscription {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  planId      String
  plan        Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)

  status             String    @default("active") // active | past_due | canceled
  interval           String    @default("month")
  // Current billing period (null on the free plan = no expiry)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  // Phase 5.1: a trial is a PAID entitlement on a timer. It gets its own
  // column rather than being inferred from currentPeriodEnd because a lapsed
  // trial must stop granting Pro, whereas a genuinely paid subscription that
  // is merely late must not be downgraded by a local clock check. The two are
  // indistinguishable if you only have a period end. See lib/server/trial.ts.
  trialEndsAt DateTime?

  canceledAt DateTime?

  // Provider linkage — razorpaySubscriptionId when the recurring rail is on
  provider               String? // "razorpay" | "manual"
  providerSubscriptionId String?

  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, status])
}

model Invoice {
  id             String        @id @default(cuid())
  workspaceId    String
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  number            String    @unique // human-readable: ARLX-2026-000001
  amountPaise       Int
  currency          String    @default("INR")
  status            String    @default("due") // due | paid | void
  // Payment rail actually used for this invoice
  paymentMethod     String    @default("manual") // manual | razorpay
  // Razorpay linkage + idempotent webhook key
  razorpayOrderId   String?   @unique
  razorpayPaymentId String?
  paidAt            DateTime?
  notes             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, status])
}

model WebhookEvent {
  // Razorpay webhook idempotency: every delivered event id is recorded once;
  // replays are acknowledged but never re-applied.
  id          String   @id // provider event id
  provider    String
  type        String
  processedAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Search upgrades: saved searches + query analytics.
//
// A SavedSearch is a reproducible (query, type facet, sort) triple the user
// can re-run from the /search page or the ⌘K palette — stored as normalized
// JSON (lib/search/facets.ts) so it renders with the same ranking code.
// SearchQueryLog is the analytics floor: one row per executed search with
// its hit count. Zero-hit queries are the "users searched, found nothing"
// signal; aggregation is pure (aggregateSearchAnalytics).
// ---------------------------------------------------------------------------

model SavedSearch {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  name   String // user-editable label; defaults to the query
  query  String
  filter String // JSON { type: string|null, sort: "relevance"|"recent" }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([workspaceId, userId, updatedAt])
}

model SearchQueryLog {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  query    String
  hitCount Int

  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt])
}

// ---------------------------------------------------------------------------
// Semantic Layer: Custom Metric Definitions (DAX-based)
// ---------------------------------------------------------------------------

model CustomMetric {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  datasetId String?
  dataset   Dataset? @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  name          String
  description   String?
  daxExpression String
  format        String  @default("number") // number | currency | percentage
  tags          String  @default("[]") // JSON string[]

  isBuiltin Boolean @default(false)
  isGlobal  Boolean @default(false) // true = available across all datasets in workspace

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, datasetId])
  @@index([workspaceId, projectId])
}

// ---------------------------------------------------------------------------
// Books workspace (CA firm work — Phase B)
//
// A persisted double-entry book of accounts. `lib/engine/accounting.ts` owns
// the arithmetic (debits must equal credits, integer minor units); these models
// own the storage. Every voucher stores the signed minor-unit amounts on its
// lines, with positive = debit and negative = credit, so the invariant can be
// re-checked from the database at any time.
//
// Books are workspace-scoped: a CA firm's other clients can never read one
// client's ledger.
// ---------------------------------------------------------------------------

/// A set of books for one entity (a client, or the firm's own accounts).
model Book {
  id                String     @id @default(cuid())
  workspaceId       String
  organizationId    String?  // Links to Organization (for multi-tenant CA firms)
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name              String
  legalName         String?
  gstin             String?
  pan               String?
  entityType        String   @default("company") // company | llp | firm | individual
  booksFrom         String?  // ISO yyyy-mm-dd opening date
  fiscalYearEnd     String   @default("03-31")
  isDemo            Boolean  @default(false)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  accounts              BookAccount[]
  vouchers              BookVoucher[]
  gstInvoices           GstInvoice[]
  bankFeeds             BankFeed[]
  bankMatchRules        BankMatchRule[]
  expenseRules          ExpenseRule[]
  adjustmentJournals    AdjustmentJournal[]
  auditEntries          BookAuditEntry[]
  fixedAssets           FixedAsset[]
  vehicles              Vehicle[]
  inventoryItems        InventoryItem[]
  inventoryMovements    InventoryMovement[]
  payrollEmployees      PayrollEmployee[]
  payrollSalaryStructures PayrollSalaryStructure[]
  payrollRuns           PayrollRun[]
  tdsEntries            TdsEntry[]
  closingEntries        ClosingEntry[]
  carryForwards         CarryForward[]
  coaMappings           CoaMapping[]
  gstEntities           GstEntity[]
  gstRegistrations      GstRegistration[]
  rcmRegisterEntries    RcmRegisterEntry[]
  gstNotices            GstNotice[]
  noticeReconciliationArtifacts NoticeReconciliationArtifact[]
  ewayBills             EwayBill[]
  gstSuppliers          GstSupplier[]
  gstFilingCampaigns    GstFilingCampaign[]
  documentRequests      ClientDocumentRequest[]

  fiscalPeriodLocks     FiscalPeriodLock[]
  subledgerPostings     SubledgerPosting[]

  @@index([workspaceId])
}

/// Fiscal period lock records. Business accounting data, not subject personal data.
model FiscalPeriodLock {
  id             String    @id @default(cuid())
  bookId         String
  book           Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  period         String
  lockedAt       DateTime @default(now())
  lockedById     String
  reason         String?

  @@unique([bookId, period])
  @@index([bookId])
}

/// Subledger posting records. Accounting data, not subject personal data.
model SubledgerPosting {
  id                String    @id @default(cuid())
  bookId            String
  book              Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  sourceType        String
  sourceId          String
  voucherId         String  @unique
  voucher           BookVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  postedAt          DateTime @default(now())
  postedById        String?

  @@unique([bookId, sourceType, sourceId])
  @@index([bookId])
  @@index([voucherId])
}

/// One account in the chart of accounts. `code` is unique within a book.
model BookAccount {
  id     String @id @default(cuid())
  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  code           String
  name           String
  type           String // asset | liability | equity | income | expense
  category       String
  description    String?
  /**
   * Opening balance in MINOR UNITS (paise), journal sign: positive = debit.
   */
  openingBalance Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines                 BookVoucherLine[]
  adjustmentJournalLines AdjustmentJournalLine[]
  closingEntryLines     ClosingEntryLine[]
  carryForwardLines     CarryForwardLine[]

  @@unique([bookId, code])
  @@index([bookId])
}

/// A journal voucher. Lines are stored on `BookVoucherLine`.
model BookVoucher {
  id                String      @id @default(cuid())
  bookId            String
  organizationId    String?   // Links to Organization (for multi-tenant CA firms)
  book              Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)

  number            String
  date              String    // ISO yyyy-mm-dd
  narration         String
  reference         String?
  voucherType       String    @default("journal") // journal | payment | receipt | sales | purchase | contra | credit-note | debit-note
  status            String    @default("posted") // posted | unposted | draft
  postedAt          DateTime? // ISO timestamp when voucher was posted
  totalDebit        Int?      // Total debit amount (minor units)
  totalCredit       Int?      // Total credit amount (minor units)

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  lines             BookVoucherLine[]
  payrollRuns       PayrollRun[]
  tdsEntries        TdsEntry[]
  subledgerPostings SubledgerPosting[]

  @@unique([bookId, number])
  @@index([bookId, date])
}

/// A single line of a voucher: signed minor units, positive = debit.
model BookVoucherLine {
  id        String      @id @default(cuid())
  voucherId String
  voucher   BookVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  accountId String
  account   BookAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  amount    Int
  narration String?

  @@index([voucherId])
  @@index([accountId])
}

// ---------------------------------------------------------------------------
// CA Bookkeeping — Extended Registers & Workflows
// ---------------------------------------------------------------------------

/// GST Invoice Register — persistent outward/inward supply ledger with ITC
/// matching against 2A/2B over time. One book (client entity) can have many
/// invoices; the register supports GSTR-1/3B computation and reconciliation.
model GstInvoice {
  id           String   @id @default(cuid())
  bookId       String
  book         Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  // Core invoice identity
  invoiceNumber    String
  invoiceDate      String     // ISO yyyy-mm-dd
  invoiceType      String     // b2b | b2c | export | sezwop | deemed | credit-note | debit-note
  supplyType       String     // intra | inter
  placeOfSupply    String

  // Party details
  supplierGstin    String?
  supplierName     String?
  recipientGstin   String?
  recipientName    String?
  recipientState   String?

  // Taxable values & tax (minor units = paise)
  taxableValue     Int        @default(0)
  cgstAmount       Int        @default(0)
  sgstAmount       Int        @default(0)
  igstAmount       Int        @default(0)
  cessAmount       Int        @default(0)

  // ITC eligibility & classification
  itcEligibility   String     @default("eligible") // eligible | ineligible | blocked | reversed | partial
  itcHeading       String?    // e.g. "Capital goods", "Input service", "Capital goods reversal"
  rcm              Boolean    @default(false)

  // 2A/2B matching (filled when auto-matched or manually reconciled)
  matched2a2b      Boolean    @default(false)
  matchedAt        DateTime?
  matchedById      String?
  gstr2aRef        String?    // GSTR-2A/2B reference for the matched record
  mismatchReason   String?

  // E-invoice / IRN
  irn              String?
  irnDate          String?
  ackNumber        String?
  ackDate          String?

  // Source & workflow
  source           String     @default("manual") // manual | tally | gst-portal | gsp | api
  status           String     @default("draft")  // draft | validated | posted | cancelled | amended
  period           String     // yyyy-mm (for GSTR-1/3B bucketing)
  reference        String?    // voucher number, challan, etc.

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  createdById      String?
  updatedById      String?

  @@unique([bookId, invoiceNumber])
  @@index([bookId, invoiceDate])
  @@index([bookId, period])
  @@index([bookId, recipientGstin])
  @@index([bookId, supplierGstin])
  @@index([bookId, matched2a2b])
  @@index([bookId, itcEligibility])
}

/// GST filing campaign — a scheduled/prepared return (GSTR-1/3B/9) for a book+
/// GSTIN. Mirrors the FilingCampaign shape in the gst-filing route: the runbook
/// files against the IT portal later, so acknowledgement fields (ack, IRN) and
/// the signing method are tracked here rather than re-derived from invoices.
model GstFilingCampaign {
  id            String @id @default(cuid())
  bookId        String
  book          Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  gstin         String
  formType      String @default("gstr-3b") // gstr-1 | gstr-3b | gstr-9
  period        String // yyyy-mm (yyyy-mm-dd due dates are on the campaign itself)
  dueDate       String // ISO yyyy-mm-dd
  signingMethod String @default("evc") // dsc | evc | etm
  status        String @default("draft") // draft | prepared | filed | rejected | error

  ackNumber     String?
  ackDate       String? // ISO yyyy-mm-dd acknowledgement date
  irn           String?
  filedById     String?
  filedAt       String? // ISO yyyy-mm-ddThh:mm:ssZ
  notes         String?
  createdById   String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([bookId, status])
  @@index([bookId, formType, period])
  @@index([bookId, gstin])
}

/// Bank Feed — imported bank statements with auto-matching rules and
/// reconciliation status. One book can have many bank accounts (each a feed).
model BankFeed {
  id           String   @id @default(cuid())
  bookId       String
  book         Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  accountName     String       // e.g. "HDFC Current A/c 0042"
  accountNumber   String       // last 4 digits or masked
  bankName        String
  ifsc            String?
  feedType        String       @default("manual") // manual | open-banking | api | statement-upload

  // Statement meta
  statementFrom   String       // ISO yyyy-mm-dd
  statementTo     String       // ISO yyyy-mm-dd
  openingBalance  Int          @default(0)   // minor units, bank sign convention
  closingBalance  Int          @default(0)

  // Import tracking
  sourceFileHash  String?      // SHA-256 of uploaded file for deduplication
  importedAt      DateTime     @default(now())
  importedById    String

  // Reconciliation status
  reconciled      Boolean      @default(false)
  reconciledAt    DateTime?
  reconciledById  String?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  transactions    BankTransaction[]

  @@index([bookId, accountNumber])
  @@index([bookId, reconciled])
}

/// A single row from a bank statement (credits positive, debits negative in bank convention)
model BankTransaction {
  id             String       @id @default(cuid())
  feedId         String
  feed           BankFeed     @relation(fields: [feedId], references: [id], onDelete: Cascade)

  date           String       // ISO yyyy-mm-dd
  narration      String
  amount         Int          // minor units, bank convention: positive = credit to account
  reference      String?      // cheque no, UTR, etc.
  valueDate      String?

  // Auto-matching
  matchStatus    String       @default("unmatched") // unmatched | suggested | confirmed | ignored
  matchedVoucherId String?    // BookVoucher.id when matched
  matchScore     Int?         // 0-100 confidence
  matchRuleId    String?      // BankMatchRule.id if rule-based

  // Manual override
  overrideById   String?
  overrideAt     DateTime?
  overrideNote   String?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([feedId, date])
  @@index([feedId, matchStatus])
  @@index([feedId, matchedVoucherId])
}

/// Bank Matching Rule — user-defined rules to auto-match bank transactions to vouchers
model BankMatchRule {
  id           String   @id @default(cuid())
  bookId       String
  book         Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  name         String
  description  String?

  // Conditions (all must match)
  minAmount    Int?       // minor units, absolute
  maxAmount    Int?
  amountTolerance Int     @default(0) // minor units
  narrationContains String? // case-insensitive substring
  referencePattern String? // regex
  dateWindowDays Int      @default(3) // statement date within X days of voucher date
  voucherTypes String     @default("[]") // JSON array of voucher types e.g. ["payment", "receipt"]

  // Action
  autoConfirm  Boolean    @default(false)

  active       Boolean    @default(true)
  priority     Int        @default(100)

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  createdById  String

  @@index([bookId, active])
}

/// Expense Classification Rule — maps narration/party/account to expense heads
model ExpenseRule {
  id           String   @id @default(cuid())
  bookId       String
  book         Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  name         String
  description  String?

  // Match conditions
  accountCodePattern String?   // regex on BookAccount.code
  narrationPattern  String?    // case-insensitive substring on voucher narration
  partyGstinPattern String?    // regex on counterparty GSTIN
  amountMin      Int?
  amountMax      Int?
  voucherTypes   String     @default("[]") // JSON array of voucher types

  // Classification result
  expenseHead    String       // target account code or category
  taxTreatment   String?      // e.g. "business", "personal", "blocked"
  gstRate        Int?         // if applicable
  itcEligibility String?      // eligible | ineligible | partial

  active       Boolean    @default(true)
  priority     Int        @default(100)

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  createdById  String

  @@index([bookId, active])
}

/// Adjustment Journal — period-end adjustments with reversing entry support
model AdjustmentJournal {
  id           String   @id @default(cuid())
  bookId       String
  book         Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  number       String     // e.g. "ADJ-2025-001"
  date         String     // ISO yyyy-mm-dd (effective date)
  narration    String
  reference    String?    // workpaper ref, approval note

  adjustmentType String   // accrual | deferral | depreciation | provision | revaluation | other
  reverses     Boolean    @default(false)
  reverseDate  String?    // ISO yyyy-mm-dd when reversing entry should post
  reversedFromId String?  // AdjustmentJournal.id of the original if this is a reversal

  // Lines (same sign convention as BookVoucher: positive = debit)
  lines        AdjustmentJournalLine[]

  // Workflow
  status       String     @default("draft") // draft | approved | posted | reversed
  approvedById String?
  approvedAt   DateTime?
  postedById   String?
  postedAt     DateTime?

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  createdById  String

  @@unique([bookId, number])
  @@index([bookId, date])
  @@index([bookId, status])
  @@index([bookId, adjustmentType])
}

/// Single line of an adjustment journal
model AdjustmentJournalLine {
  id              String            @id @default(cuid())
  journalId       String
  journal         AdjustmentJournal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  accountId       String
  account         BookAccount       @relation(fields: [accountId], references: [id], onDelete: Restrict)

  amount          Int              // minor units, positive = debit
  narration       String?

  @@index([journalId])
  @@index([accountId])
}

/// Book Audit Trail — immutable log of every change to books data
model BookAuditEntry {
  id               String   @id @default(cuid())
  bookId           String
  book             Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  entityType       String     // BookVoucher | BookAccount | GstInvoice | BankFeed | BankTransaction | AdjustmentJournal | FixedAsset | Vehicle | InventoryItem | PayrollRun | TdsEntry
  entityId         String
  action           String     // create | update | delete | post | unpost | match | unmatch | approve | reverse
  fieldChanges     String?    // JSON of { field: { old, new } }
  before           String?    // JSON snapshot before
  after            String?    // JSON snapshot after
  prevHash       String?
  hash           String?

  actorId          String
  actorName        String?
  ipAddress        String?
  userAgent        String?

  createdAt        DateTime   @default(now())

  @@index([bookId, entityType, entityId])
  @@index([bookId, actorId])
  @@index([bookId, createdAt])
}

/// Fixed Asset Register — persisted assets with dual depreciation (Companies Act + IT)
model FixedAsset {
  id           String   @id @default(cuid())
  bookId       String
  book         Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  assetCode    String   // unique within book, e.g. "FA-001"
  name         String
  description  String?

  // Acquisition
  cost         Int      @default(0)        // minor units
  acquisitionDate String
  putToUseDate String
  invoiceRef   String?    // GST invoice number or purchase voucher

  // Classification
  bookClass    String     // Companies Act useful life class (from COMPANIES_ACT_USEFUL_LIVES)
  taxBlock     String     // Income Tax block id (from INCOME_TAX_BLOCK_RATES)
  location     String?
  custodian    String?

  // Depreciation state (brought forward)
  openingBookDepreciation Int @default(0) // minor units

  // Disposal
  disposed     Boolean    @default(false)
  disposalDate String?
  disposalProceeds Int    @default(0)
  disposalGainLoss Int    @default(0)   // book gain/loss (signed)
  disposalTaxEffect Int     @default(0) // u/s 50 effect (signed)

  // Additional depreciation (32(1)(iia))
  eligibleAddlDepreciation Boolean @default(false)
  addlDepreciationRate Int?         // percentage

  // Workflow
  status       String     @default("active") // active | disposed | transferred | impaired
  fy           String     // financial year "2025-26"

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  createdById  String
  updatedById  String?

  // Inverse relation
  vehicles Vehicle[]

  @@unique([bookId, assetCode])
  @@index([bookId, fy])
  @@index([bookId, status])
}

/// Vehicle Register — subset of fixed assets with vehicle-specific fields
model Vehicle {
  id           String   @id @default(cuid())
  bookId       String
  book         Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  assetId      String?  // link to FixedAsset if also tracked there
  asset        FixedAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  vehicleCode  String   // unique within book
  registrationNumber String
  chassisNumber String?
  engineNumber  String?

  vehicleType  String   // car | truck | two-wheeler | bus | other
  make         String
  model        String
  yearOfMfr    Int?

  // Ownership
  ownershipType String   @default("owned") // owned | leased | hired
  lessorName   String?
  leaseExpiry  String?

  // Insurance & Compliance
  insuranceExpiry String?
  fitnessExpiry   String?
  permitExpiry    String?
  pucExpiry       String?

  // Usage
  currentOdometer Int?
  avgMonthlyKms   Int?

  // Tax
  gstInputClaimed Boolean  @default(false)
  gstInputAmount  Int      @default(0)

  status       String     @default("active") // active | sold | scrapped | transferred
  fy           String

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  createdById  String

  @@unique([bookId, vehicleCode])
  @@unique([bookId, registrationNumber])
  @@index([bookId, fy])
}

/// Inventory Register — item master + stock ledger
model InventoryItem {
  id           String   @id @default(cuid())
  bookId       String
  book         Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  itemCode     String   // unique within book
  name         String
  description  String?
  hsnCode      String?
  unit         String   @default("PCS") // PCS | MTR | KG | LTR | BOX | SET

  // Tax
  gstRate      Int      @default(18)
  cessRate     Int      @default(0)
  itcEligible  Boolean  @default(true)

  // Stock tracking
  openingQty   Int      @default(0)    // base units (minor for qty)
  openingValue Int      @default(0)    // minor units
  openingDate  String?  // when opening stock taken

  // Reorder
  reorderLevel Int?
  maxLevel     Int?
  leadTimeDays Int?

  // Valuation
  valuationMethod String  @default("fifo") // fifo | wavg | lifo | specific

  // Workflow
  active       Boolean  @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdById  String

  // Inverse relation
  movements InventoryMovement[]

  @@unique([bookId, itemCode])
  @@index([bookId, hsnCode])
  @@index([bookId, active])
}

/// Inventory Movement — every stock change (purchase, sale, adjustment, transfer)
model InventoryMovement {
  id           String   @id @default(cuid())
  bookId       String
  book         Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  itemId       String
  item         InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  date         String   // ISO yyyy-mm-dd
  movementType String   // purchase | sale | return | adjustment | transfer-in | transfer-out | manufacture | consumption
  qty          Int      // signed: positive = in, negative = out
  rate         Int      // minor units per unit (cost for in, sale price for out)
  amount       Int      // minor units (qty * rate)
  narration    String?
  reference    String?  // voucher, delivery challan, GRN

  // Batch/lot for specific valuation
  batchNumber  String?
  expiryDate   String?

  createdAt    DateTime @default(now())
  createdById  String

  @@index([bookId, itemId, date])
  @@index([bookId, movementType])
  @@index([bookId, reference])
}

/// Payroll — Employee Master
model PayrollEmployee {
  id           String   @id @default(cuid())
  bookId       String
  book         Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  employeeCode String   // unique within book
  name         String
  pan          String?
  uan          String?  // Universal Account Number (PF)
  esiNumber    String?
  aadhaar      String?  // masked

  // Personal
  dateOfBirth  String?
  dateOfJoining String
  dateOfLeaving String?
  gender       String?
  category     String?  // general | sc | st | obc | ews

  // Salary Structure (monthly, minor units)
  basic        Int      @default(0)
  da           Int      @default(0)
  hra          Int      @default(0)
  specialAllowance Int  @default(0)
  otherAllowances Int  @default(0)
  conveyance   Int      @default(0)
  medical      Int      @default(0)

  // Statutory
  pfApplicable   Boolean @default(true)
  esiApplicable  Boolean @default(true)
  ptApplicable   Boolean @default(true)
  lwfApplicable  Boolean @default(false)
  voluntaryPf    Int     @default(0) // VPF
  npsContribution Int   @default(0)

  // Bank
  bankAccount   String?
  ifsc          String?

  // Workflow
  status        String   @default("active") // active | resigned | terminated | on-leave
  department    String?
  designation   String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   String

  // Inverse relations
  salaryStructures    PayrollSalaryStructure[]
  payrollRunEmployees PayrollRunEmployee[]

  @@unique([bookId, employeeCode])
  @@unique([bookId, pan])
  @@index([bookId, status])
}

/// Payroll Salary Structure — versioned salary template per employee
model PayrollSalaryStructure {
  id           String   @id @default(cuid())
  bookId       String
  book         Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     PayrollEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  effectiveFrom String  // ISO yyyy-mm-dd
  effectiveTo   String? // null = current

  // Components (monthly, minor units)
  basic         Int @default(0)
  da            Int @default(0)
  hra           Int @default(0)
  specialAllowance Int @default(0)
  otherAllowances Int @default(0)
  conveyance    Int @default(0)
  medical       Int @default(0)

  // Deductions (monthly, minor units)
  pfEmployee    Int @default(0)
  pfEmployer    Int @default(0)
  eps           Int @default(0)
  edli          Int @default(0)
  pfAdmin       Int @default(0)
  esiEmployee   Int @default(0)
  esiEmployer   Int @default(0)
  professionalTax Int @default(0)
  lwf           Int @default(0)
  tds           Int @default(0)
  otherDeductions Int @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   String

  @@unique([employeeId, effectiveFrom])
  @@index([bookId, effectiveFrom])
}

/// Payroll Run — monthly payroll processing
model PayrollRun {
  id           String   @id @default(cuid())
  bookId       String
  book         Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  period       String   // yyyy-mm
  runDate      String   // ISO yyyy-mm-dd
  status       String   @default("draft") // draft | approved | paid | locked

  // State for state-specific calculations (professional tax, etc.)
  state        String   @default("Maharashtra")

  // Summary (minor units)
  totalGross       Int @default(0)
  totalDeductions  Int @default(0)
  totalNet         Int @default(0)
  totalEmployerCost Int @default(0)

  // Statutory ceilings used (for audit trail)
  pfWageCeiling   Int
  esiWageCeiling  Int
  ptMonthly       Int

  // Journal link
  voucherId       String?
  voucher         BookVoucher? @relation(fields: [voucherId], references: [id])

  // Workflow
  approvedById    String?
  approvedAt      DateTime?
  paidById        String?
  paidAt          DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdById     String

  employees       PayrollRunEmployee[]

  @@unique([bookId, period])
  @@index([bookId, status])
}

/// Employee row in a payroll run
model PayrollRunEmployee {
  id           String   @id @default(cuid())
  runId        String
  run          PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     PayrollEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Salary components for this run (minor units)
  basic         Int @default(0)
  da            Int @default(0)
  hra           Int @default(0)
  specialAllowance Int @default(0)
  otherAllowances Int @default(0)
  conveyance    Int @default(0)
  medical       Int @default(0)
  bonus         Int @default(0)
  grossSalary   Int @default(0)

  // Deductions
  pfEmployee    Int @default(0)
  pfEmployer    Int @default(0)
  eps           Int @default(0)
  edli          Int @default(0)
  pfAdmin       Int @default(0)
  esiEmployee   Int @default(0)
  esiEmployer   Int @default(0)
  professionalTax Int @default(0)
  lwf           Int @default(0)
  tds           Int @default(0)
  voluntaryPf   Int @default(0)
  nps           Int @default(0)
  otherDeductions Int @default(0)
  totalDeductions Int @default(0)

  netPay        Int @default(0)
  employerCost  Int @default(0)

  // Statutory details
  pfWages       Int @default(0)
