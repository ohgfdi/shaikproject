// ---------------------------------------------------------------------------
// Prompt library
// ---------------------------------------------------------------------------

model Prompt {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name              String
  description       String?
  template          String
  variables         String  @default("[]") // JSON string[]
  chain             String  @default("[]") // JSON string[]
  isAdvisorTemplate Boolean @default(false)

